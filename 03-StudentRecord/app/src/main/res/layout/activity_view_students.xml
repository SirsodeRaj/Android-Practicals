<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:backgroundTint="#E8EAF6"
            android:layout_marginBottom="18dp" />


        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Records"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All saved student information"
            android:textSize="15sp"
            android:textColor="#777777"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="24dp" />


        <!-- Total Count -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#E8EAF6">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL STUDENTS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tvStudentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A237E" />

        </LinearLayout>


        <!-- Records Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVED RECORDS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />


        <!-- Student Records -->

        <LinearLayout
            android:id="@+id/recordsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Empty Message -->

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No student records found."
                android:textSize="16sp"
                android:textColor="#777777"
                android:gravity="center"
                android:padding="30dp"
                android:background="#F5F5F5" />

        </LinearLayout>


        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developed by Raj Sirsode"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#607D8B"
            android:gravity="center"
            android:layout_marginTop="300dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>