<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FC"
    tools:context=".MainActivity">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁  WEATHER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1769AA"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather at a glance"
            android:textSize="14sp"
            android:textColor="#607D8B"
            android:layout_marginTop="4dp" />

    </LinearLayout>


    <!-- ================= MAIN CONTENT ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <!-- City Input -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textSize="28sp"
                android:textColor="#1769AA"
                android:layout_marginEnd="8dp" />

            <AutoCompleteTextView
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@android:color/white"
                android:hint="Enter city name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="16sp"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:completionThreshold="1" />

        </LinearLayout>


        <!-- Get Weather Button -->

        <Button
            android:id="@+id/btnGetWeather"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CHECK WEATHER"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1769AA"
            android:layout_marginTop="16dp"
            android:elevation="3dp" />


        <!-- Loading Indicator -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />


        <!-- ================= WEATHER RESULT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:padding="22dp"
            android:layout_marginTop="22dp">

            <!-- Weather Icon -->

            <TextView
                android:id="@+id/tvWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="54sp"
                android:gravity="center" />

            <!-- City -->

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:layout_marginTop="8dp" />

            <!-- Temperature -->

            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- °C"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1769AA"
                android:layout_marginTop="2dp" />

            <!-- Weather Condition -->

            <TextView
                android:id="@+id/tvWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather condition"
                android:textSize="18sp"
                android:textColor="#607D8B"
                android:layout_marginTop="2dp" />


            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E6EA"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />


            <!-- Weather Details -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Feels Like -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FEELS LIKE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#78909C" />

                    <TextView
                        android:id="@+id/tvFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#263238"
                        android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- Humidity -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUMIDITY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#78909C" />

                    <TextView
                        android:id="@+id/tvHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#263238"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- Error Message -->

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>


    <!-- ================= FOOTER ================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Developed by Raj Sirsode"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#607D8B"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="18dp" />

</LinearLayout>